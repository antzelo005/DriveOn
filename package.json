{
  "name": "driveon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "playwright test",
    "verify:pages": "node scripts/verify-pages.mjs",
    "test:firefox": "node scripts/test-firefox.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "format": "prettier --write src scripts tests vite.config.ts playwright.config.ts README.md"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.45.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "lighthouse": "^13.4.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
